# General
# ------------------------------------------------------------------------------
# DJANGO_READ_DOT_ENV_FILE=True
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=supersecretproductionkeyvalue
DJANGO_ADMIN_URL=supersecretadminurl/
DJANGO_ALLOWED_HOSTS=.example.com

# Security
# ------------------------------------------------------------------------------
# TIP: better off using DNS, however, redirect is OK too
DJANGO_SECURE_SSL_REDIRECT=False

# Email (AWS SES via django-anymail)
# ------------------------------------------------------------------------------
DJANGO_SERVER_EMAIL=
DJANGO_DEFAULT_FROM_EMAIL=

# SES IAM credentials (the `ses-sender` IAM user in services/aws/).
# Scoped by Resource ARN + ses:FromAddress condition — these keys can ONLY
# send mail as *@<verified-domain>, nothing else.
DJANGO_AWS_SES_ACCESS_KEY_ID=
DJANGO_AWS_SES_SECRET_ACCESS_KEY=
DJANGO_AWS_SES_REGION_NAME=us-east-1
DJANGO_AWS_SES_CONFIGURATION_SET=default-feedback


# AWS (S3 / storage — separate IAM user from SES above)
# ------------------------------------------------------------------------------
DJANGO_AWS_ACCESS_KEY_ID=
DJANGO_AWS_SECRET_ACCESS_KEY=
DJANGO_AWS_STORAGE_BUCKET_NAME=

# django-allauth
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# Gunicorn
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=4

# Sentry
# ------------------------------------------------------------------------------
SENTRY_DSN=


# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=admin
CELERY_FLOWER_PASSWORD=supersecretpassword


