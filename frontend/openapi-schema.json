      type: object
      description: Extended serializer that includes private fields for the profile
        owner.
      properties:
        uuid:
          type: string
          format: uuid
          readOnly: true
        user_email:
          type: string
          format: email
          readOnly: true
        user_first_name:
          type: string
          readOnly: true
        user_last_name:
          type: string
          readOnly: true
        user_avatar:
          type: string
          format: uri
          readOnly: true
        license_status:
