      operationId: api_service_areas_list
      description: List all service areas.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedServiceAreaList'
          description: ''
  /api/users/:
    get:
      operationId: api_users_list
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedUserList'
          description: ''
  /api/users/{id}/:
    get:
      operationId: api_users_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this user.
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
    put:
      operationId: api_users_update
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this user.
        required: true
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UserRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/UserRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/UserRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
    patch:
      operationId: api_users_partial_update
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this user.
        required: true
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUserRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUserRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUserRequest'
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
  /api/users/change-password/:
    post:
      operationId: api_users_change_password_create
      description: Change user password with old password verification.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordChangeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordChangeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordChangeRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/users/me/:
    get:
      operationId: api_users_me_retrieve
      description: Get or update the current user's profile.
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
    patch:
      operationId: api_users_me_partial_update
      description: Get or update the current user's profile.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUserRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUserRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUserRequest'
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
components:
  schemas:
    Conversation:
      type: object
      properties:
        uuid:
          type: string
          format: uuid
          readOnly: true
        participant_1:
          allOf:
          - $ref: '#/components/schemas/ProfessionalProfile'
          readOnly: true
        participant_2:
          allOf:
          - $ref: '#/components/schemas/ProfessionalProfile'
          readOnly: true
        gig:
          type: string
          format: uuid
          readOnly: true
        last_message:
          type: object
          additionalProperties: {}
          nullable: true
          readOnly: true
        unread_count:
          type: integer
          readOnly: true
        modified:
          type: string
          format: date-time
          readOnly: true
      required:
      - gig
      - last_message
      - modified
      - participant_1
      - participant_2
      - unread_count
      - uuid
    ConversationCreate:
      type: object
      properties:
        participant_uuid:
          type: string
          format: uuid
        gig_uuid:
          type: string
          format: uuid
          nullable: true
      required:
      - participant_uuid
    ConversationCreateRequest:
      type: object
      properties:
        participant_uuid:
          type: string
          format: uuid
        gig_uuid:
          type: string
          format: uuid
          nullable: true
      required:
      - participant_uuid
    EmailTokenObtainPairRequest:
      type: object
      description: Custom JWT serializer that uses email and checks email verification.
      properties:
        email:
          type: string
          writeOnly: true
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - email
      - password
    Gig:
      type: object
      description: Read serializer for gig list/detail.
      properties:
        uuid:
          type: string
          format: uuid
          readOnly: true
        title:
          type: string
          maxLength: 255
        description:
          type: string
        location_address:
          type: string
          maxLength: 500
        location_lat:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
          title: Location latitude
        location_lng:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
          title: Location longitude
        scheduled_date:
          type: string
          format: date
        scheduled_time:
          type: string
          format: time
        budget_range_min:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
          title: Budget range minimum
        budget_range_max:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
          title: Budget range maximum
        agreed_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
          nullable: true
        status:
          allOf:
          - $ref: '#/components/schemas/Status92cEnum'
          readOnly: true
        gig_type:
          $ref: '#/components/schemas/GigTypeEnum'
        posted_by:
          allOf:
          - $ref: '#/components/schemas/ProfessionalProfile'
          readOnly: true
        assigned_to:
          allOf:
          - $ref: '#/components/schemas/ProfessionalProfile'
          readOnly: true
        created:
          type: string
          format: date-time
          readOnly: true
        modified:
          type: string
          format: date-time
          readOnly: true
      required:
      - agreed_price
      - assigned_to
      - created
      - location_address
      - modified
      - posted_by
      - scheduled_date
      - scheduled_time
      - status
      - title
      - uuid
    GigCreate:
      type: object
      description: Serializer for creating gigs.
      properties:
        title:
          type: string
          maxLength: 255
        description:
          type: string
        location_address:
          type: string
          maxLength: 500
        location_lat:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
          title: Location latitude
        location_lng:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
          title: Location longitude
        scheduled_date:
          type: string
          format: date
        scheduled_time:
          type: string
          format: time
        budget_range_min:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
          title: Budget range minimum
        budget_range_max:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
          title: Budget range maximum
        gig_type:
          $ref: '#/components/schemas/GigTypeEnum'
      required:
      - location_address
      - scheduled_date
      - scheduled_time
      - title
    GigCreateRequest:
      type: object
      description: Serializer for creating gigs.
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 255
        description:
          type: string
        location_address:
          type: string
          minLength: 1
          maxLength: 500
        location_lat:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
          title: Location latitude
        location_lng:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
          title: Location longitude
        service_area_uuid:
          type: string
          format: uuid
          writeOnly: true
          nullable: true
        scheduled_date:
          type: string
          format: date
        scheduled_time:
          type: string
          format: time
        budget_range_min:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
          title: Budget range minimum
        budget_range_max:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
          title: Budget range maximum
        gig_type:
          $ref: '#/components/schemas/GigTypeEnum'
      required:
      - location_address
      - scheduled_date
      - scheduled_time
      - title
    GigInvitation:
      type: object
      description: Read serializer for gig invitations.
      properties:
        uuid:
          type: string
          format: uuid
          readOnly: true
        invited_agent:
          allOf:
          - $ref: '#/components/schemas/ProfessionalProfile'
          readOnly: true
        proposed_rate:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
        message:
          type: string
        status:
          $ref: '#/components/schemas/GigInvitationStatusEnum'
        created:
          type: string
          format: date-time
          readOnly: true
      required:
      - created
      - invited_agent
      - uuid
    GigInvitationCreate:
      type: object
      description: Serializer for creating gig invitations.
      properties:
        invited_agent_uuid:
          type: string
          format: uuid
        message:
          type: string
          default: ''
      required:
      - invited_agent_uuid
    GigInvitationCreateRequest:
      type: object
      description: Serializer for creating gig invitations.
      properties:
        invited_agent_uuid:
          type: string
          format: uuid
        message:
          type: string
          minLength: 1
          default: ''
      required:
      - invited_agent_uuid
    GigInvitationRequest:
      type: object
      description: Read serializer for gig invitations.
      properties:
        proposed_rate:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
        message:
          type: string
        status:
          $ref: '#/components/schemas/GigInvitationStatusEnum'
    GigInvitationStatusEnum:
      enum:
      - pending
      - accepted
      - declined
      - withdrawn
      type: string
      description: |-
        * `pending` - Pending
        * `accepted` - Accepted
        * `declined` - Declined
        * `withdrawn` - Withdrawn
    GigRequest:
      type: object
      description: Read serializer for gig list/detail.
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 255
        description:
          type: string
        location_address:
          type: string
          minLength: 1
          maxLength: 500
        location_lat:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
          title: Location latitude
        location_lng:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
          title: Location longitude
        scheduled_date:
          type: string
          format: date
        scheduled_time:
          type: string
          format: time
        budget_range_min:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
          title: Budget range minimum
        budget_range_max:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
          title: Budget range maximum
        gig_type:
          $ref: '#/components/schemas/GigTypeEnum'
      required:
      - location_address
      - scheduled_date
      - scheduled_time
      - title
    GigStatusTransitionRequest:
      type: object
      description: Validates gig status transitions.
      properties:
        status:
          $ref: '#/components/schemas/Status92cEnum'
      required:
      - status
    GigTypeEnum:
      enum:
      - showing
      - open_house
      - inspection_accompaniment
      - other
      type: string
      description: |-
        * `showing` - Showing
        * `open_house` - Open House
        * `inspection_accompaniment` - Inspection Accompaniment
        * `other` - Other
    LicenseStatusEnum:
      enum:
      - pending_verification
      - verified
      - rejected
      - expired
      type: string
      description: |-
        * `pending_verification` - Pending Verification
        * `verified` - Verified
        * `rejected` - Rejected
        * `expired` - Expired
    Message:
