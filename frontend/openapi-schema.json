        license_expiry:
          type: string
          format: date
          readOnly: true
          nullable: true
        verified_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        rejection_reason:
          type: string
          readOnly: true
        has_stripe_account:
          type: boolean
