          - $ref: '#/components/schemas/ProfessionalProfile'
          readOnly: true
        body:
          type: string
        read_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        created:
          type: string
          format: date-time
          readOnly: true
      required:
      - body
      - created
      - read_at
      - sender
      - uuid
    MessageCreate:
      type: object
      properties:
        body:
          type: string
      required:
      - body
    MessageCreateRequest:
      type: object
      properties:
        body:
          type: string
          minLength: 1
      required:
      - body
    Metro:
      type: object
      properties:
        uuid:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 255
        state:
          type: string
          maxLength: 2
      required:
      - name
      - state
      - uuid
    MetroRequest:
      type: object
