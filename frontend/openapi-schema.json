            $ref: '#/components/schemas/SpecializationsEnum'
          readOnly: true
        bio:
          type: string
          readOnly: true
        average_rating:
          type: string
          format: decimal
          pattern: ^-?\d{0,1}(?:\.\d{0,2})?$
          readOnly: true
          nullable: true
        average_response_time:
          type: string
          readOnly: true
          nullable: true
        is_available:
